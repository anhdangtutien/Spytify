{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spytify",
  "version": "1.1.6",
  "identifier": "com.spytify.music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spytify",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 200,
        "decorations": false,
        "transparent": false,
        "additionalBrowserArgs": "--hide-media-capture-notification --disable-features=Translate,OptimizationHints,MediaRouter,TabCaptureNotification --disk-cache-size=33554432 --media-cache-size=33554432"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
