{
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/app/assets/$1" },
    { "source": "/mobile/(.*)", "destination": "/app/$1" },
    { "source": "/mobile", "destination": "/app/index.html" },
    { "source": "/app/(.*)", "destination": "/app/$1" },
    { "source": "/app", "destination": "/app/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,HEAD" },
        { "key": "Access-Control-Allow-Headers", "value": "Range,Content-Type" }
      ]
    }
  ]
}
