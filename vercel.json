{
  "rewrites": [
    { "source": "/api/yt-stream", "destination": "/api/yt-stream.js" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,HEAD" },
        { "key": "Access-Control-Allow-Headers", "value": "Range,Content-Type" }
      ]
    }
  ]
}
